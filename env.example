# These values are for trusted Supabase Edge Function secrets only.
# Do not put service role, LiveKit secret, SMTP password or cron secret in konnekt_pwa/config.js.
APP_ALLOWED_ORIGIN=https://YOUR-KONNEKT-STAGING-DOMAIN
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
CLEANUP_CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_MONITORED_SUPPORT_EMAIL
