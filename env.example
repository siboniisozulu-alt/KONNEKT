# Existing Supabase URL and publishable key remain in src/lib_supabase.js.
# Never add a Supabase service_role key to VITE_ variables or the browser app.

# Optional TURN credential endpoint. It must return short-lived credentials.
# VITE_TURN_CREDENTIALS_URL=https://your-secure-endpoint.example/ice
# Optional STUN override; public STUN fallback is built in.
# VITE_STUN_URL=stun:stun.example.net:3478

# Configure OneSignal + Firebase Cloud Messaging before enabling background push.
# VITE_ONESIGNAL_APP_ID=your-public-onesignal-app-id
